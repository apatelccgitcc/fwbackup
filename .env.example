# --- Web app -------------------------------------------------------------
ADMIN_PASSWORD=change-me
# Long random string. Also encrypts firewall passwords stored in the database,
# so don't change it after you've saved logins. Generate: openssl rand -hex 32
APP_SECRET_KEY=
# The address people use to open the app (used for links in the email)
APP_BASE_URL=http://localhost:8080

# --- Sophos Fusion / Central partner API credential --------------------------
# Fusion Partner: Settings & policies > API credentials. The credential must be allowed to run
# firewall configuration exports for your customer tenants (Sophos recommends the
# "Service Principal Firewall" role for tenant credentials).
SOPHOS_CLIENT_ID=
SOPHOS_CLIENT_SECRET=

# --- Fallback: firewall XML API (optional) -------------------------------------------
# Only needed for firewalls older than SFOS 22.0 MR2, which Fusion can't export.
# Default login used for every firewall that doesn't have its own (can also be set in Settings)
FW_DEFAULT_USERNAME=
FW_DEFAULT_PASSWORD=
FW_API_PORT=4444
FW_VERIFY_TLS=false
FW_TIMEOUT=45
FW_CONCURRENCY=6

# --- Email -------------------------------------------------------------------------
# smtp  -> any SMTP relay (Microsoft 365 SMTP AUTH, SendGrid, Mailgun, your own relay)
# graph -> Microsoft 365 via Graph (Entra app with Mail.Send application permission)
EMAIL_METHOD=smtp
MAIL_FROM=firewall-reports@yourdomain.com

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
